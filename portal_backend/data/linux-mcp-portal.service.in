[Unit]
Description=Linux MCP RemoteDesktop portal backend
PartOf=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.linux_mcp
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/linux-mcp-portal
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
